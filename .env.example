# ==============================================================================
# HaulBoX Logistics Platform — Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to .env and fill in all real values.
# NEVER commit the actual .env file to Git.
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production')
NODE_ENV=production
PORT=3000

# PostgreSQL Supabase Database Connection String
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Google Cloud OAuth 2.0 Credentials (Gmail Send/Reply, Drive Upload)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-production-app.onrender.com/auth/google/callback

# Super Admin & Admin Allowed Google Accounts
SUPER_ADMIN_EMAIL=haulbox2361@gmail.com
ADMIN_EMAILS=haulbox2361@gmail.com

# 6-Digit Admin Settings PIN — CHANGE THIS before production deployment
SETTINGS_ADMIN_PIN=CHANGE_ME_6_DIGITS

# Express Session Secret — MUST be a strong random 32+ character string
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_STRING_32_CHARS_MINIMUM

# Mistral AI API Key — Required for BOL/POD OCR extraction
# Get from: https://console.mistral.ai/api-keys
# NOTE: OCR extracts text for reviewer display only — it CANNOT approve or reject documents.
MISTRAL_API_KEY=your-mistral-api-key-here

# Firebase Cloud Messaging (FCM) Service Account JSON (Optional for Android Push)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
