# ==============================================================================
# HaulBoX Logistics Platform — Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production')
NODE_ENV=production
PORT=3000

# PostgreSQL Supabase Database Connection String
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Google Cloud OAuth 2.0 Credentials (Gmail Send/Reply, Drive Upload)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-production-app.onrender.com/auth/google/callback

# Super Admin & Admin Allowed Google Accounts
SUPER_ADMIN_EMAIL=haulbox2361@gmail.com
ADMIN_EMAILS=haulbox2361@gmail.com

# 6-Digit Admin Settings PIN (Required to unlock security settings in web dashboard)
SETTINGS_ADMIN_PIN=123456

# Express Session Secret (Generate a strong 32+ char random string)
SESSION_SECRET=haulbox_secure_enterprise_session_secret_change_in_production_32char

# Firebase Cloud Messaging (FCM) Service Account JSON (Optional for Android Push)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
